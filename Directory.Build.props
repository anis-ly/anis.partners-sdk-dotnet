<Project>
  <PropertyGroup>
    <!--
      Multi-targeted because an SDK's constraint is the PARTNER's runtime, not ours: net10-only would
      exclude exactly the enterprise .NET shops this package exists for.
    -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      Who publishes it and where it lives. The package's own identity, description and readme are in the
      library's project file; everything here is shared so the three projects cannot disagree.
    -->
    <Authors>Anis</Authors>
    <Company>Anis</Company>
    <Copyright>Copyright © 2026 Aniscom for Technical Services (Anis)</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/anis-ly/anis.partners-sdk-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>

    <!-- A released build is reproducible from the commit alone; a local build keeps local paths for debugging. -->
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- A local build is never mistaken for a release. The release workflow sets Version from the tag. -->
    <Version Condition="'$(Version)' == ''">0.0.0-local</Version>
  </PropertyGroup>
</Project>
